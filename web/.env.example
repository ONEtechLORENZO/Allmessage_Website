# Public address of the site, no trailing slash. Used for the canonical URL, hreflang links,
# robots.txt, sitemap.xml, JSON-LD and the social-preview image address.
SITE_URL=https://allmessage.otech.one

# Where the Milo app is deployed. Every /products/milo/... request is forwarded there.
# Leave it empty to switch Milo off: no Milo links on the pages, /products/milo/ is a 404 and
# robots.txt doesn't list Milo's sitemap. For local work: MILO_URL=http://localhost:5050
MILO_URL=
