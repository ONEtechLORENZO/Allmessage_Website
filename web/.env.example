# Public address of the site, no trailing slash. Used for the canonical URL, hreflang links,
# robots.txt, sitemap.xml, JSON-LD and the social-preview image address (AllMessage and Milo pages).
SITE_URL=https://allmessage.otech.one

# Milo page, optional:
# Google Analytics 4 measurement ID. Loads only after the visitor accepts cookies.
NEXT_PUBLIC_GA_ID=
# Milo contact form email delivery via Resend. Without these, messages are only logged on the server.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
